# ============================================================
# Storyblok (CMS)
# ============================================================
STORYBLOK_TOKEN=            # Access token (Preview ou Public)
STORYBLOK_REGION=eu         # Région du space : eu | us | ap | ca | cn
STORYBLOK_VERSION=published # draft (éditeur) | published (prod)
STORYBLOK_WEBHOOK_SECRET=   # Secret partagé avec le webhook Storyblok (revalidation ISR)

# ============================================================
# Supabase (Auth + base de données)
# ============================================================
SUPABASE_URL=               # https://<project-ref>.supabase.co
SUPABASE_KEY=               # Clé anon/public (côté client)

# ============================================================
# Resend (emails)
# ============================================================
RESEND_API_KEY=             # Clé API Resend (formulaire contact + notifications admin)

# ============================================================
# Supabase (service role — côté serveur uniquement, ne jamais exposer)
# ============================================================
SUPABASE_SERVICE_KEY=       # Clé service role (Settings > API dans Supabase)

# ============================================================
# HelloAsso (paiement des sorties)
# ============================================================
HELLOASSO_CLIENT_ID=        # OAuth2 client ID
HELLOASSO_CLIENT_SECRET=    # OAuth2 client secret
HELLOASSO_ORG_SLUG=         # Slug de l'organisation (ex: asc-escalade-chevigny)

# ============================================================
# Site
# ============================================================
SITE_URL=https://asc-escalade.fr   # URL de prod (pour les redirects HelloAsso)
